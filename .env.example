# Environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# The deployed implementation (activity_a/app.py) uses Groq's OpenAI-compatible
# API via ChatOpenAI(base_url="https://api.groq.com/openai/v1"). This is the
# only variable actually read by the code — model ("openai/gpt-oss-20b") and
# temperature (0.3) are hardcoded in activity_a/app.py, not read from the
# environment.
GROQ_API_KEY=your_groq_api_key_here
