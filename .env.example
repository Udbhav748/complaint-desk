# Environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# OpenAI API Key (required for LangChain OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration
OPENAI_MODEL_NAME=gpt-4o-mini

# Temperature settings (see README for engineering trade-off documentation)
# 0.0 reduces sampling variability, optimizing for focused category extraction
TEMPERATURE_CLASSIFICATION=0.0
# 0.2 reduces hallucination risk while maintaining natural phrasing in support acknowledgements
TEMPERATURE_REPLY=0.2
